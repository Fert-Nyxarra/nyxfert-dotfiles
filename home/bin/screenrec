#!/usr/bin/env bash
# screenrec — запись экрана в Hyprland поверх wf-recorder.
#
#   screenrec screen   — весь активный монитор
#   screenrec region   — выделенная мышью область
#   screenrec window   — окно, выбранное кликом
#   screenrec stop     — остановить запись
#
# Повторный вызов в любом режиме, пока идёт запись, останавливает её.
#
# Переменные окружения:
#   REC_DIR    куда складывать файлы (по умолчанию ~/Videos/Recordings)
#   REC_AUDIO  system | mic | none   (по умолчанию system — звук с колонок)
#   REC_CODEC  кодек ffmpeg          (по умолчанию libx264)
#   REC_FPS    кадров в секунду      (по умолчанию 60)

set -uo pipefail

MODE="${1:-screen}"
OUTDIR="${REC_DIR:-$HOME/Videos/Recordings}"
AUDIO="${REC_AUDIO:-system}"
CODEC="${REC_CODEC:-libx264}"
FPS="${REC_FPS:-60}"

RUNDIR="${XDG_RUNTIME_DIR:-/tmp}"
PIDFILE="$RUNDIR/screenrec.pid"
NAMEFILE="$RUNDIR/screenrec.file"
LOGFILE="$RUNDIR/screenrec.log"

notify() {  # notify <иконка hyprctl> <текст>
    # Демона org.freedesktop.Notifications в системе нет, поэтому плашку
    # рисует сам Hyprland.
    hyprctl notify "$1" 4000 0 "fontsize:14  $2" >/dev/null 2>&1
    return 0
}

die() { notify 3 "Запись не удалась: $1"; echo "screenrec: $1" >&2; exit 1; }

running_pid() {
    [ -s "$PIDFILE" ] || return 1
    local pid; pid=$(cat "$PIDFILE")
    kill -0 "$pid" 2>/dev/null || { rm -f "$PIDFILE"; return 1; }
    echo "$pid"
}

stop_recording() {
    local pid; pid=$(running_pid) || { notify 0 "Запись не идёт"; return 0; }
    kill -INT "$pid" 2>/dev/null
    for _ in $(seq 1 50); do           # ждём до 5 с, пока ffmpeg допишет контейнер
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    local f; f=$(cat "$NAMEFILE" 2>/dev/null)
    notify 5 "Запись сохранена: ${f:-?}"
    return 0
}

audio_args() {
    case "$AUDIO" in
        none) ;;
        mic)
            local src; src=$(pactl get-default-source 2>/dev/null)
            [ -n "$src" ] && printf '%s' "--audio=$src"
            ;;
        system|*)
            local sink; sink=$(pactl get-default-sink 2>/dev/null)
            [ -n "$sink" ] && printf '%s' "--audio=$sink.monitor"
            ;;
    esac
}

# --- геометрия ----------------------------------------------------------
geom_region() {
    slurp -d || return 1
}

geom_window() {
    local vis rects
    vis=$(hyprctl monitors -j | jq -c '[.[].activeWorkspace.id]')
    rects=$(hyprctl clients -j | jq -r --argjson vis "$vis" '
        .[] | select(.mapped) | select(.workspace.id as $i | $vis | index($i))
        | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    [ -n "$rects" ] || return 1
    printf '%s\n' "$rects" | slurp -r || return 1
}

active_monitor() {
    hyprctl monitors -j | jq -r '.[] | select(.focused) | .name'
}

# --- старт --------------------------------------------------------------
[ "$MODE" = "stop" ] && { stop_recording; exit 0; }
running_pid >/dev/null && { stop_recording; exit 0; }

for bin in wf-recorder slurp jq hyprctl; do
    command -v "$bin" >/dev/null 2>&1 || die "не найден $bin"
done

args=()
case "$MODE" in
    screen)
        mon=$(active_monitor)
        [ -n "$mon" ] || die "не определён активный монитор"
        args+=(-o "$mon")
        ;;
    region)
        g=$(geom_region) || exit 0          # Esc при выделении — просто выходим
        args+=(-g "$g")
        ;;
    window)
        g=$(geom_window) || exit 0
        args+=(-g "$g")
        ;;
    *) die "неизвестный режим: $MODE" ;;
esac

mkdir -p "$OUTDIR"
FILE="$OUTDIR/$(date +%Y-%m-%d_%H-%M-%S)_$MODE.mp4"

aud=$(audio_args)
[ -n "$aud" ] && args+=("$aud")

# pad до чётных размеров: yuv420p не переваривает нечётную ширину/высоту
args+=(-c "$CODEC" -r "$FPS" -F "pad=ceil(iw/2)*2:ceil(ih/2)*2" -f "$FILE")

start() {  # start [доп. флаги]
    wf-recorder "$@" "${args[@]}" >"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

if ! start; then
    # На проприетарном NVIDIA захват через dmabuf порой отваливается.
    rm -f "$FILE"
    if ! start --no-dmabuf; then
        rm -f "$PIDFILE" "$FILE"
        die "$(tail -n 3 "$LOGFILE" | tr '\n' ' ')"
    fi
fi

printf '%s' "$FILE" > "$NAMEFILE"
notify 1 "Идёт запись ($MODE) → $(basename "$FILE")"
