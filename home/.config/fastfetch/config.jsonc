// ~/.config/matugen/templates/fastfetch-template.jsonc
// генерирует matugen -> ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "nixos_small",
    "color": {
      "1": "38;2;255;109;124",
      "2": "38;2;222;187;188",
      "3": "38;2;255;109;124",
      "4": "38;2;222;187;188",
      "5": "38;2;255;109;124",
      "6": "38;2;222;187;188",
      "7": "38;2;255;109;124",
      "8": "38;2;222;187;188",
      "9": "38;2;255;109;124"
    },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;109;124",
      "title": "38;2;255;109;124",
      "output": "38;2;222;187;188"
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;222;187;188",
        "at": "38;2;255;109;124",
        "host": "38;2;222;187;188"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "length": 18,
      "outputColor": "38;2;255;109;124"
    },

    { "type": "os",       "key": "  os    " },
    { "type": "kernel",   "key": "  kernel" },
    { "type": "uptime",   "key": "󰅐  uptime" },
    { "type": "packages", "key": "󰏖  pkgs  " },
    { "type": "shell",    "key": "  shell " },
    { "type": "wm",       "key": "  wm    " },
    { "type": "terminal", "key": "  term  " },

    { "type": "cpu",    "key": "󰻠  cpu   ", "format": "{name}" },
    { "type": "gpu",    "key": "󰢮  gpu   ", "format": "{name}" },
    { "type": "memory", "key": "󰍛  memory" },
    { "type": "disk",   "key": "󰋊  disk  ", "format": "{size-used} / {size-total} ({size-percentage})" },

    {
      "type": "custom",
      "format": "{#38;2;222;187;188}● {#38;2;255;109;124}● {#38;2;255;109;124}● {#38;2;246;122;37}● {#38;2;122;0;32}●"
    }
  ]
}
